# DevOps with Docker, Fall 2026
# offer by The University of Helsinki
# chapter 4 Using a non-root user
# url: https://courses.mooc.fi/org/uh-cs/courses/devops-with-docker-fall-2026/chapter-4/using-a-non-root-user
# Exercise 3.5. Optimized project
# created at Nov 09, 2026 00:48 HKT

FROM ubuntu

WORKDIR /app

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

# Install system dependencies (Cached forever unless this block changes)

# Add Node repository and install Node.js (Cached)


# Copy application source code

# manually configure API path (see README.md of exercise 1.12)

RUN <<EOF
apt-get update
apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg

curl -sL https://deb.nodesource.com/setup_16.x | bash - 
apt-get install -y nodejs 

rm -rf /var/lib/apt/lists/*

npm install
npm run build
npm install -g serve

rm -rf src

useradd -m frontend-appuser
chown frontend-appuser .
EOF

# change the user
USER frontend-appuser

CMD [ "serve", "-s", "-l", "5001", "build" ]

